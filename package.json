{
  "name": "my-discord-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint src/",
    "check": "biome check --write src/"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.50",
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-ai": "latest",
    "discord.js": "^14.0.0",
    "dotenv": "^17.4.2",
    "typebox": "^1.1.37",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  }
}
