{
  "name": "my-discord-agent",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "build:runner": "esbuild src/sandbox/agent-runner.ts --bundle --platform=node --target=node22 --format=esm --external:better-sqlite3 --banner:js='import { createRequire } from \"module\"; const require = createRequire(import.meta.url);' --outfile=dist/sandbox/runner.bundle.mjs",
    "build:tool-runtime": "esbuild src/runtime/agent-reach-runtime.ts --bundle --platform=node --target=node22 --format=esm --external:playwright --outfile=dist/tool-runtime.mjs",
    "sandbox": "bash scripts/sandbox.sh",
    "memory-core": "docker compose -f compose.memory-core.yaml",
    "reddit:login": "tsx scripts/reddit-cookie-login.ts",
    "x-saved:setup": "tsx scripts/x-saved-setup.ts",
    "runner:image:build": "pnpm build:runner && docker build -t localhost:5050/my-discord-agent-runner:latest . && docker push localhost:5050/my-discord-agent-runner:latest",
    "runner:image:smoke": "bash scripts/runner-image-smoke.sh",
    "restart": "pnpm sandbox build && pnpm build && node dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "discord:deploy": "node --env-file-if-exists=.env --import tsx scripts/deploy-discord-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && python3 -m unittest templates/SKILLS/interest-profile/scripts/test_extract_interests.py",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint src/ .pi/extensions/",
    "check": "biome check --write src/"
  },
  "dependencies": {
    "@azure/msal-node": "^5.2.2",
    "@earendil-works/pi-agent-core": "latest",
    "@earendil-works/pi-ai": "latest",
    "better-sqlite3": "^12.11.1",
    "content-type": "^2.0.0",
    "discord.js": "^14.0.0",
    "dotenv": "^17.4.2",
    "encoding-sniffer": "^1.0.2",
    "feedparser": "^2.6.0",
    "html-to-text": "^10.0.0",
    "playwright": "^1.61.0",
    "typebox": "^1.1.37",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22"
  }
}
