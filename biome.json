{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@earendil-works/pi-agent-core": {
                "importNames": ["Agent"],
                "message": "ツール付きAgentの生成はサンドボックスコンテナ内（src/sandbox/agent-runner.ts）に限定してください。"
              }
            }
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "src/**/*",
      "vitest.config.ts",
      "config/**/*",
      ".pi/extensions/**/*.ts"
    ]
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "off"
          }
        }
      }
    },
    {
      "includes": ["src/sandbox/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
