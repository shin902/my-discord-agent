FROM node:22-bookworm-slim AS build

WORKDIR /build
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY src ./src
RUN pnpm build:tool-runtime

FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv curl ca-certificates xvfb chromium iptables util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN corepack enable && pnpm install --prod --frozen-lockfile
RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir yt-dlp feedparser
RUN pnpm exec playwright install-deps chromium || true

ENV PATH="/opt/venv/bin:$PATH"
COPY --from=build /build/dist/tool-runtime.mjs ./tool-runtime.mjs
COPY scripts/tool-runtime-entrypoint.sh ./tool-runtime-entrypoint.sh
RUN chmod 755 ./tool-runtime-entrypoint.sh
ENV TZ="Asia/Tokyo"
ENV NODE_ENV="production"
ENTRYPOINT ["/app/tool-runtime-entrypoint.sh"]
CMD ["node", "/app/tool-runtime.mjs"]
