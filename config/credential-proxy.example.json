[
  {
    "provider": "openai",
    "envVars": ["OPENAI_API_KEY"],
    "baseUrl": "https://api.openai.com/v1"
  },
  {
    "provider": "azure-openai-responses",
    "envVars": [
      "AZURE_OPENAI_API_KEY",
      "AZURE_OPENAI_BASE_URL",
      "AZURE_OPENAI_RESOURCE_NAME",
      "AZURE_OPENAI_API_VERSION",
      "AZURE_OPENAI_DEPLOYMENT_NAME_MAP"
    ],
    "baseUrl": "https://{AZURE_OPENAI_RESOURCE_NAME}.openai.azure.com/openai/v1",
    "overrideUrlEnvVar": "AZURE_OPENAI_BASE_URL"
  },
  {
    "provider": "anthropic",
    "envVars": ["ANTHROPIC_OAUTH_TOKEN", "ANTHROPIC_API_KEY"],
    "baseUrl": "https://api.anthropic.com"
  },
  {
    "provider": "deepseek",
    "envVars": ["DEEPSEEK_API_KEY"],
    "baseUrl": "https://api.deepseek.com"
  },
  {
    "provider": "google",
    "envVars": ["GEMINI_API_KEY"],
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
  },
  {
    "provider": "google-vertex",
    "envVars": [
      "GOOGLE_CLOUD_API_KEY",
      "GOOGLE_CLOUD_PROJECT",
      "GCLOUD_PROJECT",
      "GOOGLE_CLOUD_LOCATION",
      "GOOGLE_APPLICATION_CREDENTIALS"
    ],
    "baseUrl": "https://{GOOGLE_CLOUD_LOCATION}-aiplatform.googleapis.com"
  },
  {
    "provider": "groq",
    "envVars": ["GROQ_API_KEY"],
    "baseUrl": "https://api.groq.com/openai/v1"
  },
  {
    "provider": "cerebras",
    "envVars": ["CEREBRAS_API_KEY"],
    "baseUrl": "https://api.cerebras.ai/v1"
  },
  {
    "provider": "xai",
    "envVars": ["XAI_API_KEY"],
    "baseUrl": "https://api.x.ai/v1"
  },
  {
    "provider": "openrouter",
    "envVars": ["OPENROUTER_API_KEY"],
    "baseUrl": "https://openrouter.ai/api/v1"
  },
  {
    "provider": "vercel-ai-gateway",
    "envVars": ["AI_GATEWAY_API_KEY"],
    "baseUrl": "https://ai-gateway.vercel.sh"
  },
  {
    "provider": "zai",
    "envVars": ["ZAI_API_KEY"],
    "baseUrl": "https://api.z.ai/api/coding/paas/v4"
  },
  {
    "provider": "mistral",
    "envVars": ["MISTRAL_API_KEY"],
    "baseUrl": "https://api.mistral.ai"
  },
  {
    "provider": "minimax",
    "envVars": ["MINIMAX_API_KEY"],
    "baseUrl": "https://api.minimax.io/anthropic"
  },
  {
    "provider": "minimax-cn",
    "envVars": ["MINIMAX_CN_API_KEY"],
    "baseUrl": "https://api.minimaxi.com/anthropic"
  },
  {
    "provider": "moonshotai",
    "envVars": ["MOONSHOT_API_KEY"],
    "baseUrl": "https://api.moonshot.ai/v1"
  },
  {
    "provider": "moonshotai-cn",
    "envVars": ["MOONSHOT_API_KEY"],
    "baseUrl": "https://api.moonshot.cn/v1"
  },
  {
    "provider": "huggingface",
    "envVars": ["HF_TOKEN"],
    "baseUrl": "https://router.huggingface.co/v1"
  },
  {
    "provider": "fireworks",
    "envVars": ["FIREWORKS_API_KEY"],
    "baseUrl": "https://api.fireworks.ai/inference"
  },
  {
    "provider": "opencode",
    "envVars": ["OPENCODE_API_KEY"],
    "baseUrl": "https://opencode.ai/zen/v1"
  },
  {
    "provider": "opencode-go",
    "envVars": ["OPENCODE_API_KEY"],
    "baseUrl": "https://opencode.ai/zen/go"
  },
  {
    "provider": "kimi-coding",
    "envVars": ["KIMI_API_KEY"],
    "baseUrl": "https://api.kimi.com/coding"
  },
  {
    "provider": "cloudflare-workers-ai",
    "envVars": ["CLOUDFLARE_API_KEY", "CLOUDFLARE_ACCOUNT_ID"],
    "baseUrl": "https://api.cloudflare.com/client/v4/accounts/{CLOUDFLARE_ACCOUNT_ID}/ai/v1"
  },
  {
    "provider": "cloudflare-ai-gateway",
    "envVars": [
      "CLOUDFLARE_API_KEY",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_GATEWAY_ID"
    ],
    "baseUrl": "https://gateway.ai.cloudflare.com/v1/{CLOUDFLARE_ACCOUNT_ID}/{CLOUDFLARE_GATEWAY_ID}"
  },
  {
    "provider": "xiaomi",
    "envVars": ["XIAOMI_API_KEY"],
    "baseUrl": "https://api.xiaomimimo.com/anthropic"
  },
  {
    "provider": "xiaomi-token-plan-cn",
    "envVars": ["XIAOMI_TOKEN_PLAN_CN_API_KEY"],
    "baseUrl": "https://token-plan-cn.xiaomimimo.com/anthropic"
  },
  {
    "provider": "xiaomi-token-plan-ams",
    "envVars": ["XIAOMI_TOKEN_PLAN_AMS_API_KEY"],
    "baseUrl": "https://token-plan-ams.xiaomimimo.com/anthropic"
  },
  {
    "provider": "xiaomi-token-plan-sgp",
    "envVars": ["XIAOMI_TOKEN_PLAN_SGP_API_KEY"],
    "baseUrl": "https://token-plan-sgp.xiaomimimo.com/anthropic"
  },
  {
    "provider": "github-copilot",
    "envVars": ["COPILOT_GITHUB_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"],
    "baseUrl": "https://api.individual.githubcopilot.com"
  },
  {
    "provider": "amazon-bedrock",
    "envVars": [
      "AWS_PROFILE",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_BEARER_TOKEN_BEDROCK",
      "AWS_CONTAINER_CREDENTIALS_RELATIVE_URI",
      "AWS_CONTAINER_CREDENTIALS_FULL_URI",
      "AWS_WEB_IDENTITY_TOKEN_FILE",
      "AWS_REGION"
    ],
    "baseUrl": "https://bedrock-runtime.{AWS_REGION}.amazonaws.com"
  }
]
