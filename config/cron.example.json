[
  {
    "id": "daily-report",
    "schedule": "0 9 * * *",
    "enabled": true,
    "groupName": "my-group",
    "prompt": "昨日のログを分析して日次レポートを作成してください",
    "channelId": "YOUR_CHANNEL_ID",
    "mode": "to-thread",
    "model": { "provider": "zai", "modelId": "glm-4.7-flash" },
    "tools": ["read", "grep"],
    "skills": ["session-logs"]
  },
  {
    "id": "mail-check",
    "schedule": "*/30 * * * *",
    "enabled": true,
    "handler": "jobs/mail.ts"
  },
  {
    "id": "reddit-cookie-refresh",
    "schedule": "0 4 */3 * *",
    "enabled": true,
    "handler": "jobs/reddit-cookie-refresh.ts"
  },
  {
    "id": "x-cookie-refresh",
    "schedule": "0 4 */3 * *",
    "enabled": false,
    "handler": "jobs/x-cookie-refresh.ts",
    "settings": {
      "profileDir": "data/x-browser-profile",
      "cookieFile": "data/x-cookies.json"
    }
  },
  {
    "id": "issue-triage",
    "schedule": "0 * * * *",
    "enabled": true,
    "groupName": "issue-triage",
    "channelId": "YOUR_CHANNEL_ID",
    "handler": "jobs/issue-triage.ts",
    "settings": {
      "owner": "YOUR_GITHUB_USERNAME",
      "repo": "YOUR_REPO_NAME"
    }
  },
  {
    "id": "memory-daily",
    "schedule": "0 23 * * *",
    "enabled": true,
    "groupName": "my-group",
    "prompt": "session-logsスキルを使って今日のセッションログを確認し、今日やったこと・決定事項・未解決事項を簡潔にまとめて memory/YYYY-MM-DD.md(今日の日付)に保存してください。今日記録対象のセッションが無ければファイルは作らず、その旨だけ報告してください。",
    "channelId": "YOUR_CHANNEL_ID",
    "mode": "to-channel"
  },
  {
    "id": "memory-weekly",
    "schedule": "0 23 * * 0",
    "enabled": true,
    "groupName": "my-group",
    "prompt": "memory/ 配下の直近7日分の YYYY-MM-DD.md と既存の MEMORY.md を読み比べ、今後も参照する価値がある情報だけを MEMORY.md に統合してください。一度きりの作業ログは反映しないこと。MEMORY.md 全体で2000字程度に収めること。",
    "channelId": "YOUR_CHANNEL_ID",
    "mode": "to-channel"
  },
  {
    "id": "finance-monthly",
    "schedule": "0 9 1 * *",
    "enabled": true,
    "groupName": "YOUR_GROUP_NAME",
    "channelId": "YOUR_CHANNEL_ID",
    "handler": "jobs/finance-monthly.js",
    "settings": {
      "lookbackMonths": 1
    }
  },
  {
    "id": "finance-subscription-reminder",
    "schedule": "0 9 * * *",
    "enabled": true,
    "groupName": "YOUR_GROUP_NAME",
    "channelId": "YOUR_CHANNEL_ID",
    "handler": "jobs/finance-subscription-reminder.js",
    "settings": {
      "daysAhead": 7
    }
  }
]
