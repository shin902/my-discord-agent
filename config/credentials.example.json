[
  {
    "provider": "zai",
    "forceCustom": true,
    "envVars": ["ZAI_API_KEY"],
    "baseUrl": "https://api.z.ai/api/coding/paas/v4"
  },
  {
    "provider": "openai",
    "forceCustom": true,
    "envVars": ["OPENAI_API_KEY"],
    "baseUrl": "https://api.openai.com/v1"
  },
  {
    "provider": "anthropic",
    "envVars": ["ANTHROPIC_OAUTH_TOKEN", "ANTHROPIC_API_KEY"],
    "baseUrl": "https://api.anthropic.com"
  },
  {
    "provider": "deepseek",
    "envVars": ["DEEPSEEK_API_KEY"],
    "baseUrl": "https://api.deepseek.com"
  },
  {
    "provider": "google",
    "envVars": ["GEMINI_API_KEY"],
    "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
  },
  {
    "provider": "groq",
    "forceCustom": true,
    "envVars": ["GROQ_API_KEY"],
    "baseUrl": "https://api.groq.com/openai/v1"
  },
  {
    "provider": "openrouter",
    "envVars": ["OPENROUTER_API_KEY"],
    "baseUrl": "https://openrouter.ai/api/v1"
  },
  {
    "provider": "graph",
    "baseUrl": "https://graph.microsoft.com/v1.0",
    "msal": {
      "tenantId": "consumers",
      "clientId": "YOUR_CLIENT_ID",
      "scopes": ["https://graph.microsoft.com/Mail.Read"]
    }
  },
  {
    "provider": "google-calendar",
    "baseUrl": "https://www.googleapis.com/calendar/v3",
    "google": {
      "clientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID",
      "clientSecretEnvVar": "GOOGLE_CALENDAR_CLIENT_SECRET",
      "scopes": ["https://www.googleapis.com/auth/calendar"]
    }
  },
  {
    "provider": "reddit",
    "baseUrl": "https://www.reddit.com",
    "redditCookie": {
      "cookieFile": "data/reddit-cookies.json",
      "maxAgeDays": 7
    }
  },
  {
    "provider": "opencode-go",
    "envVars": ["OPENCODE_API_KEY"],
    "baseUrl": "https://opencode.ai/zen/go/v1"
  },
  {
    "provider": "llama-cpp",
    "baseUrl": "http://localhost:8080/v1",
    "api": "openai-completions"
  },
  {
    "provider": "llama-cpp-qwen3",
    "baseUrl": "http://localhost:8080/v1",
    "api": "openai-completions",
    "contextWindow": 65536,
    "maxTokens": 4096,
    "compat": { "thinkingFormat": "qwen-chat-template" },
    "models": {
      "qwen3-vl": { "input": ["text", "image"] }
    }
  },
  {
    "provider": "ollama-qwen3",
    "baseUrl": "http://localhost:11434/v1",
    "api": "openai-completions",
    "contextWindow": 65536,
    "maxTokens": 4096,
    "compat": {
      "thinkingFormat": "openrouter",
      "thinkingLevelMap": {
        "off": "none",
        "minimal": "low",
        "xhigh": "high"
      }
    }
  },
  {
    "provider": "nvidia-nim",
    "envVars": ["NVIDIA_NIM_API_KEY"],
    "forceCustom": true,
    "baseUrl": "https://integrate.api.nvidia.com/v1",
    "api": "openai-completions"
  },
  {
    "provider": "browserless",
    "baseUrl": "https://production-sfo.browserless.io",
    "envVars": ["BROWSERLESS_TOKEN"],
    "auth": { "type": "query-token", "queryParam": "token" }
  },
  {
    "provider": "tavily",
    "envVars": ["TAVILY_API_KEY"],
    "baseUrl": "https://api.tavily.com"
  },
  {
    "provider": "github",
    "envVars": ["GITHUB_ISSUE_TRIAGE_TOKEN"],
    "baseUrl": "https://api.github.com"
  },
  {
    "provider": "github-git",
    "envVars": ["GITHUB_CLONE_TOKEN"],
    "baseUrl": "https://github.com",
    "auth": { "type": "basic", "username": "x-access-token" }
  }
]
