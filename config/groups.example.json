[
  {
    "name": "default",
    "model": {
      "provider": "zai",
      "modelId": "glm-4.7-flash"
    },
    "tools": [
      "read",
      "write",
      "edit",
      "list",
      "glob",
      "grep",
      "tavily-search",
      "agent-reach",
      "bot"
    ],
    "approvalRequiredTools": ["tavily-search"],
    "contextFiles": [
      { "path": "memory/index.md", "maxChars": 16000 },
      { "path": "memory/system/definition.md", "maxChars": 16000 }
    ],
    "allowMention": false,
    "toolLogArgs": true,
    "channels": [
      { "channelId": "YOUR_CHANNEL_ID", "sessionMode": "shared" },
      {
        "channelId": "YOUR_RESTRICTED_CHANNEL_ID",
        "sessionMode": "shared",
        "requiredMention": true,
        "tools": ["read"],
        "approvalRequiredTools": [],
        "contextFiles": [],
        "skills": [],
        "mounts": []
      }
    ],
    "mounts": [
      {
        "host": "/path/to/your/folder",
        "container": "/folder",
        "readOnly": false
      }
    ]
  },
  {
    "name": "issue-triage",
    "bot": "public",
    "tools": ["bash", "list-issues", "read-issue", "comment-issue"],
    "allowMention": false,
    "toolLogArgs": true,
    "channels": [],
    "mounts": [
      {
        "host": "/path/to/a/clean/clone/of/this/repo",
        "container": "/repos",
        "readOnly": true
      }
    ]
  }
]
