{
  "defaultModel": {
    "provider": "opencode-go",
    "modelId": "kimi-k2.6"
  },
  "credentials": [
    {
      "provider": "openai",
      "envVars": ["OPENAI_API_KEY"],
      "baseUrl": "https://api.openai.com/v1"
    },
    {
      "provider": "anthropic",
      "envVars": ["ANTHROPIC_OAUTH_TOKEN", "ANTHROPIC_API_KEY"],
      "baseUrl": "https://api.anthropic.com"
    },
    {
      "provider": "deepseek",
      "envVars": ["DEEPSEEK_API_KEY"],
      "baseUrl": "https://api.deepseek.com"
    },
    {
      "provider": "google",
      "envVars": ["GEMINI_API_KEY"],
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta"
    },
    {
      "provider": "groq",
      "forceCustom": true,
      "envVars": ["GROQ_API_KEY"],
      "baseUrl": "https://api.groq.com/openai/v1"
    },
    {
      "provider": "openrouter",
      "envVars": ["OPENROUTER_API_KEY"],
      "baseUrl": "https://openrouter.ai/api/v1"
    },
    {
      "provider": "graph",
      "baseUrl": "https://graph.microsoft.com/v1.0",
      "msal": {
        "tenantId": "consumers",
        "clientId": "YOUR_CLIENT_ID",
        "scopes": ["https://graph.microsoft.com/Mail.Read"]
      }
    },
    {
      "provider": "google-calendar",
      "baseUrl": "https://www.googleapis.com/calendar/v3",
      "google": {
        "clientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID",
        "clientSecretEnvVar": "GOOGLE_CALENDAR_CLIENT_SECRET",
        "scopes": ["https://www.googleapis.com/auth/calendar"]
      }
    },
    {
      "provider": "opencode-go",
      "envVars": ["OPENCODE_API_KEY"],
      "baseUrl": "https://opencode.ai/zen/go/v1"
    },
    {
      "provider": "llama-cpp",
      "baseUrl": "http://localhost:8080/v1",
      "api": "openai-completions"
    },
    {
      "provider": "llama-cpp-qwen3",
      "baseUrl": "http://localhost:8080/v1",
      "api": "openai-completions",
      "contextWindow": 65536,
      "maxTokens": 4096,
      "compat": { "thinkingFormat": "qwen-chat-template" }
    },
    {
      "provider": "ollama-qwen3",
      "baseUrl": "http://localhost:11434/v1",
      "api": "openai-completions",
      "contextWindow": 65536,
      "maxTokens": 4096,
      "compat": { "thinkingFormat": "ollama" }
    },
    {
      "provider": "browserless",
      "baseUrl": "https://production-sfo.browserless.io",
      "envVars": ["BROWSERLESS_TOKEN"],
      "auth": { "type": "query-token", "queryParam": "token" }
    },
    {
      "provider": "tavily",
      "envVars": [
        "TAVILY_API_KEY"
      ],
      "baseUrl": "https://api.tavily.com"
    }
  ],
  "groups": [
    {
      "name": "default",
      "model": {
        "provider": "opencode-go",
        "modelId": "kimi-k2.6"
      },
      "tools": ["tavily_search"],
      "autoReply": false,
      "toolLogArgs": true,
      "channels": [{ "channelId": "YOUR_CHANNEL_ID", "sessionMode": "shared" }],
      "mounts": [
        {
          "host": "/path/to/your/folder",
          "container": "/folder",
          "readOnly": false
        }
      ]
    }
  ],
  "cron": [
    {
      "id": "daily-report",
      "schedule": "0 9 * * *",
      "enabled": true,
      "groupName": "my-group",
      "prompt": "昨日のログを分析して日次レポートを作成してください",
      "channelId": "YOUR_CHANNEL_ID",
      "mode": "to-thread"
    },
    {
      "id": "mail-check",
      "schedule": "*/30 * * * *",
      "enabled": true,
      "handler": "jobs/mail.ts"
    },
    {
      "id": "memory-daily",
      "schedule": "0 23 * * *",
      "enabled": true,
      "groupName": "my-group",
      "prompt": "session-logsスキルを使って今日のセッションログを確認し、今日やったこと・決定事項・未解決事項を簡潔にまとめて memory/YYYY-MM-DD.md(今日の日付)に保存してください。今日記録対象のセッションが無ければファイルは作らず、その旨だけ報告してください。",
      "channelId": "YOUR_CHANNEL_ID",
      "mode": "to-channel"
    },
    {
      "id": "memory-weekly",
      "schedule": "0 23 * * 0",
      "enabled": true,
      "groupName": "my-group",
      "prompt": "memory/ 配下の直近7日分の YYYY-MM-DD.md と既存の MEMORY.md を読み比べ、今後も参照する価値がある情報だけを MEMORY.md に統合してください。一度きりの作業ログは反映しないこと。MEMORY.md 全体で2000字程度に収めること。",
      "channelId": "YOUR_CHANNEL_ID",
      "mode": "to-channel"
    }
  ],
  "poller": {
    "dispatchMode": "parallel-session"
  }
}
