{
  "discord": {
    "bots": {
      "personal": {
        "applicationId": "YOUR_PERSONAL_DISCORD_APPLICATION_ID",
        "tokenEnv": "DISCORD_BOT_TOKEN"
      },
      "public": {
        "applicationId": "YOUR_PUBLIC_DISCORD_APPLICATION_ID",
        "tokenEnv": "DISCORD_PUBLIC_BOT_TOKEN"
      }
    }
  },
  "defaultModel": {
    "provider": "zai-custom",
    "modelId": "glm-4.7-flash"
  },
  "codexCloud": {
    "allowedEnvironments": []
  },
  "xSavedReceiver": {
    "enabled": false,
    "port": 8787
  },
  "screenCaptureReceiver": {
    "enabled": false,
    "port": 8788
  },
  "screenCaptureSummary": {
    "enabled": false,
    "groupName": "my-group",
    "model": { "provider": "google", "modelId": "gemini-2.5-flash" },
    "settings": {
      "mode": "summarize",
      "visionModel": { "provider": "google", "modelId": "gemini-2.5-flash" },
      "limit": 10,
      "concurrency": 4
    }
  },
  "screenCaptureDailySummary": {
    "enabled": false,
    "groupName": "my-group",
    "startDate": "2026-10-03",
    "prompt": "capturelog内の対象日 {{date}} の活動ログを分析して日次レポートを作成してください。",
    "channelId": "YOUR_CHANNEL_ID",
    "deliveryMode": "new-thread",
    "historyMode": "fresh",
    "model": { "provider": "google", "modelId": "gemini-2.5-flash" },
    "tools": ["read"]
  },
  "xSavedGallery": {
    "enabled": false,
    "port": 8789,
    "origin": "https://your-host.your-tailnet.ts.net"
  },
  "proxy": {
    "requestTimeoutMs": 120000
  },
  "compaction": {
    "enabled": true,
    "threshold": 0.7,
    "keepRecentTokens": 20000
  },
  "agentMemory": {
    "threshold": 0.7
  },
  "agent": {
    "timeoutMs": 600000
  }
}
