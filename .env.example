# Discord Bot
DISCORD_BOT_TOKEN=

# zAI (デフォルト・推奨。glm-4.7-flash は無料枠で並列実行1まで利用可能)
ZAI_API_KEY=

# --- 以下は使用するプロバイダに応じて設定（動作確認済み・config/credentials.json でデフォルト有効） ---

# OpenCode Go（kimi-k2.6 は大規模ツールコールで API エラーが頻発するため非推奨 #107）
# OPENCODE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=

# DeepSeek
# DEEPSEEK_API_KEY=

# Google (Gemini)
# GEMINI_API_KEY=

# Google Calendar（OAuth クライアントシークレット。クライアントIDは config/config.json に記載）
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Groq
# GROQ_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# Browserless（browserless_* ツールを使う場合）
# BROWSERLESS_TOKEN=

# Tavily（tavily_search ツールを使う場合）
# TAVILY_API_KEY=

# GitHub Issue Triage（list_issues/read_issue ツールを使う場合。対象リポジトリ・Issues権限のみのfine-grained PAT）
# GITHUB_ISSUE_TRIAGE_TOKEN=

# --- その他の未検証プロバイダ（Azure OpenAI, Vertex AI, Cerebras, xAI, Mistral, ---
# --- Cloudflare, MiniMax, Kimi For Coding, Moonshot AI, Hugging Face, Fireworks, ---
# --- GitHub Copilot, Amazon Bedrock, Vercel AI Gateway, Xiaomi MiMo 等）---
# 必要な環境変数名と追加手順は docs/proxy.md の「その他の pi-ai 対応プロバイダ」を参照。
