# Discord Bot
# Default bot (`personal`) used by groups without `bot`.
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# Additional bots defined in config/config.json -> discord.bots.*.tokenEnv.
# Their non-secret applicationId is configured in config/config.json.
# config/config.example.json defines `public` with this environment variable.
DISCORD_PUBLIC_BOT_TOKEN=

# TencentDB Agent MemoryCore sidecar（pnpm memory-core up -d）
# 抽出・統合に使うLLMのAPI key。MemoryCore起動時は必須。
MEMORY_CORE_LLM_API_KEY=
# MEMORY_CORE_PORT=8420
# 任意。設定する場合は config/config.json の agentMemory.bearerTokenEnv に
# "MEMORY_CORE_GATEWAY_API_KEY" を指定する。
# MEMORY_CORE_GATEWAY_API_KEY=

# zAI (デフォルト・推奨。glm-4.7-flash は無料枠で並列実行1まで利用可能)
ZAI_API_KEY=

# --- 以下は使用するプロバイダに応じて設定（動作確認済み・config/credentials.json でデフォルト有効） ---

# OpenCode Go（kimi-k2.6 は大規模ツールコールで API エラーが頻発するため非推奨 #107）
# OPENCODE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# CLIProxyAPI sidecar（ChatGPT/Codex OAuth。CLIProxyAPI 側に設定したローカルAPIキー）
# CLIPROXY_API_KEY=

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=

# DeepSeek
# DEEPSEEK_API_KEY=

# Google (Gemini)
# GEMINI_API_KEY=

# Google Calendar（OAuth クライアントシークレット。クライアントIDは config/config.json に記載）
# GOOGLE_CALENDAR_CLIENT_SECRET=

# Groq
# GROQ_API_KEY=

# OpenRouter
# OPENROUTER_API_KEY=

# NDIVIA_NIM
# NVIDIA_NIM_API_KEY=

# Browserless（browserless_* ツールを使う場合）
# BROWSERLESS_TOKEN=

# Tavily（tavily_search ツールを使う場合）
# TAVILY_API_KEY=

# GitHub REST API（Issue/PRツールを使う場合。対象リポジトリのfine-grained PAT）
# Issues: Read and write（comment-issueにはwriteが必要。読み取り専用のIssueツールだけならRead）
# Pull requests: Read（read-pull-request/list-pull-request-commentsは読み取り専用）
# GITHUB_ISSUE_TRIAGE_TOKEN=

# GitHub リポジトリ Clone（clone-repository ツールを使う場合。対象リポジトリ・Contents:Read権限のみのfine-grained PAT）
# GITHUB_CLONE_TOKEN=

# --- その他の未検証プロバイダ（Azure OpenAI, Vertex AI, Cerebras, xAI, Mistral, ---
# --- Cloudflare, MiniMax, Kimi For Coding, Moonshot AI, Hugging Face, Fireworks, ---
# --- GitHub Copilot, Amazon Bedrock, Vercel AI Gateway, Xiaomi MiMo 等）---
# 必要な環境変数名と追加手順は docs/proxy.md の「その他の pi-ai 対応プロバイダ」を参照。
